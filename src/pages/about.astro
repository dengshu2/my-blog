---
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description: "邓舒的个人博客，记录技术与生活",
	title: "关于",
};
---

<PageLayout meta={meta}>
	<div class="space-y-6">
		<h1 class="title">关于我</h1>
		<p>一个在广州的数据搬运工</p>
		<p>写博客是因为记性不好，调通的东西不写下来，三天后就像没做过一样。</p>
		<p>这里放的是技术笔记、踩过的坑、以及偶尔冒出来的想法。内容不保证正确，但保证是真折腾过的。</p>
		<p>如果哪篇文章恰好帮到了你，感谢这神奇的互联网吧。</p>
	</div>
</PageLayout>

---
import SocialList from "@/components/SocialList.astro";
import PostPreview from "@/components/blog/PostPreview.astro";
import { getAllPosts, sortMDByDate } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";

const MAX_POSTS = 10;
const allPosts = await getAllPosts();
const allPostsByDate = sortMDByDate(allPosts).slice(0, MAX_POSTS);

const projects = [
	{
		title: "GitHub 仓库管理",
		description: "可视化管理和探索 GitHub 仓库，发现有趣的开源项目",
		url: "https://astrolabe.dengshu.ovh/",
		icon: "🔭",
		tag: "探索",
	},
	{
		title: "人生大问题",
		description: "那些值得反复思考的人生问题，记录思想的碰撞与成长",
		url: "https://question.dengshu.ovh/",
		icon: "💡",
		tag: "思考",
	},
	{
		title: "效率工具",
		description: "精心挑选、打磨的个人效率工具集，让工作与生活更高效",
		url: "https://site.dengshu.ovh/",
		icon: "⚡",
		tag: "效率",
	},
];

---

<PageLayout meta={{ title: "首页" }}>
	<!-- Hero Section -->
	<section class="hero-section relative mb-10" id="hero">
		<div class="hero-badge mb-4 inline-flex items-center gap-2 rounded-full border border-accent/20 bg-accent/5 px-4 py-1.5 text-sm text-accent">
			<span class="relative flex h-2 w-2">
				<span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-75"></span>
				<span class="relative inline-flex h-2 w-2 rounded-full bg-accent"></span>
			</span>
			Open to collaborate
		</div>

		<h1 class="hero-title mb-3 text-3xl font-bold leading-tight tracking-tight text-accent-2 sm:text-4xl">
			你好，我是<span class="text-accent">邓舒</span>
		</h1>

		<p class="hero-subtitle mb-2 text-lg font-medium text-accent-2/80 sm:text-xl">
			数据开发工程师
		</p>

		<div class="hero-tagline mb-6 flex items-center gap-2 text-base text-textColor/70">
			<span class="inline-block h-px w-8 bg-accent/50"></span>
			通过 <span class="font-semibold text-accent">AI</span> + <span class="font-semibold text-accent">DATA</span> 构建杠杆
		</div>

		<SocialList />
	</section>

	<!-- Projects Section -->
	<section class="mb-12" id="projects">
		<div class="mb-5 flex items-center gap-3">
			<h2 class="title text-xl">正在探索的项目</h2>
			<span class="h-px flex-1 bg-accent/10"></span>
		</div>

		<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
			{projects.map((project, index) => (
				<a
					href={project.url}
					target="_blank"
					rel="noreferrer"
					class="project-card group relative overflow-hidden rounded-xl border border-accent/10 bg-bgColor p-4 transition-all duration-300 hover:-translate-y-1 hover:border-accent/30 hover:shadow-lg hover:shadow-accent/5"
					style={`animation-delay: ${index * 100}ms`}
				>
					<div class="mb-2 flex items-center justify-between">
						<span class="text-2xl transition-transform duration-300 group-hover:scale-110">{project.icon}</span>
						<span class="rounded-full bg-accent/10 px-2.5 py-0.5 text-xs font-medium text-accent">
							{project.tag}
						</span>
					</div>
					<h3 class="mb-2 font-semibold text-accent-2 transition-colors group-hover:text-accent">
						{project.title}
					</h3>
					<p class="text-sm leading-relaxed text-textColor/60">
						{project.description}
					</p>
					<div class="mt-3 flex items-center gap-1 text-xs text-accent/0 transition-all duration-300 group-hover:text-accent">
						<span>访问项目</span>
						<svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
						</svg>
					</div>
					<!-- hover glow effect -->
					<div class="pointer-events-none absolute -inset-px rounded-xl opacity-0 transition-opacity duration-300 group-hover:opacity-100" style="background: radial-gradient(600px circle at var(--mouse-x, 50%) var(--mouse-y, 50%), hsl(var(--theme-accent) / 0.06), transparent 40%);"></div>
				</a>
			))}
		</div>
	</section>


	<!-- Scroll Divider -->
	<div class="scroll-divider flex flex-col items-center gap-3 py-10">
		<div class="flex w-full items-center gap-4">
			<span class="h-px flex-1 bg-gradient-to-r from-transparent to-accent/20"></span>
			<a href="#posts" class="scroll-arrow group flex h-10 w-10 items-center justify-center rounded-full border border-accent/20 text-accent/40 transition-all duration-300 hover:border-accent/40 hover:text-accent">
				<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
					<path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
				</svg>
			</a>
			<span class="h-px flex-1 bg-gradient-to-l from-transparent to-accent/20"></span>
		</div>
	</div>

	<!-- Blog Posts Section -->
	<section aria-label="Blog post list" id="posts">
		<div class="mb-8 flex items-center gap-3">
			<h2 class="title text-xl">最新文章</h2>
			<span class="h-px flex-1 bg-accent/10"></span>
			<a href="/posts/" class="text-sm text-accent/70 transition-colors hover:text-accent">
				查看全部 →
			</a>
		</div>
		<ul class="space-y-4">
			{
				allPostsByDate.map((p) => (
					<li class="grid gap-2 sm:grid-cols-[auto_1fr] sm:[&_q]:col-start-2">
						{/* @ts-ignore-next-line - issue with -> @astrojs/check@0.9.3 */}
						<PostPreview post={p} />
					</li>
				))
			}
		</ul>
	</section>
</PageLayout>

<style>
	/* Fade-in animation for sections */
	@keyframes fadeInUp {
		from {
			opacity: 0;
			transform: translateY(20px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.hero-section {
		animation: fadeInUp 0.6s ease-out;
	}

	.hero-badge {
		animation: fadeInUp 0.6s ease-out 0.1s both;
	}

	.hero-title {
		animation: fadeInUp 0.6s ease-out 0.2s both;
	}

	.hero-subtitle {
		animation: fadeInUp 0.6s ease-out 0.3s both;
	}

	.hero-tagline {
		animation: fadeInUp 0.6s ease-out 0.4s both;
	}

	.project-card {
		animation: fadeInUp 0.5s ease-out both;
	}



	/* Subtle gradient border on hover for project cards */
	.project-card::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 2px;
		background: linear-gradient(90deg, transparent, hsl(var(--theme-accent) / 0.5), transparent);
		opacity: 0;
		transition: opacity 0.3s;
	}

	.project-card:hover::before {
		opacity: 1;
	}

	/* Scroll arrow bounce */
	@keyframes gentleBounce {
		0%, 100% { transform: translateY(0); }
		50% { transform: translateY(4px); }
	}

	.scroll-arrow {
		animation: gentleBounce 2s ease-in-out infinite;
	}

	.scroll-divider {
		animation: fadeInUp 0.6s ease-out 0.6s both;
	}
</style>

<script>
	// Track mouse position for card glow effect
	document.querySelectorAll('.project-card').forEach((card) => {
		card.addEventListener('mousemove', (e) => {
			const me = e as MouseEvent;
			const rect = (me.currentTarget as HTMLElement).getBoundingClientRect();
			const x = me.clientX - rect.left;
			const y = me.clientY - rect.top;
			(me.currentTarget as HTMLElement).style.setProperty('--mouse-x', `${x}px`);
			(me.currentTarget as HTMLElement).style.setProperty('--mouse-y', `${y}px`);
		});
	});
</script>

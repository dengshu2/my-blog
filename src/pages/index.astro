---
import SocialList from "@/components/SocialList.astro";
import PostPreview from "@/components/blog/PostPreview.astro";
import { getAllPosts, sortMDByDate } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";

const MAX_POSTS = 10;
const allPosts = await getAllPosts();
const allPostsByDate = sortMDByDate(allPosts).slice(0, MAX_POSTS);

const projects: { title: string; description: string; url: string }[] = [
	{
		title: "SQLForge",
		description: "SQL 格式化与方言转换工具，基于 sqlglot",
		url: "https://sqlforge.dengshu.ovh/",
	},
	{
		title: "WordCore",
		description: "英语词汇练习：看单词、写例句、AI 批改",
		url: "https://wordcore.dengshu.ovh/",
	},
	{
		title: "TransLens",
		description: "中英翻译学习工具，基于 Go + OpenRouter",
		url: "https://translate.dengshu.ovh/",
	},
	{
		title: "FlashSnap",
		description: "输入文字，用 Gemini Flash 生成杂志风格信息卡",
		url: "https://flashsnap.dengshu.ovh/",
	},
	{
		title: "Astrolabe",
		description: "可视化任意 GitHub 用户的 Star 仓库",
		url: "https://astrolabe.dengshu.ovh/",
	},
	{
		title: "The Big Questions",
		description: "人类文明经典导览：11 个大问题、300+ 思想家、900+ 著作",
		url: "https://question.dengshu.ovh/",
	},
];

---

<PageLayout meta={{ title: "首页" }}>
	<!-- Hero Section -->
	<section class="mb-8" id="hero">
		<h1 class="mb-2 text-3xl font-bold leading-tight tracking-tight text-accent-2 sm:text-4xl">
			你好，我是<span class="text-accent">邓舒</span>
		</h1>

		<p class="mb-1.5 text-lg text-textColor/70 sm:text-xl">
			数据开发工程师 · AI + DATA
		</p>

		<SocialList />
	</section>

	<!-- Projects Section -->
	<section class="mb-12" id="projects">
		<div class="mb-5 flex items-center gap-3">
			<h2 class="title text-xl">项目</h2>
			<span class="h-px flex-1 bg-accent/10"></span>
		</div>

		<div class="grid gap-4 sm:grid-cols-2">
			{projects.map((project) => (
				<a
					href={project.url}
					target="_blank"
					rel="noreferrer"
					class="group rounded-xl border border-accent/10 bg-bgColor p-4 transition-colors hover:border-accent/30"
				>
					<h3 class="mb-1.5 font-semibold text-accent-2 transition-colors group-hover:text-accent">
						{project.title}
					</h3>
					<p class="text-sm leading-relaxed text-textColor/60">
						{project.description}
					</p>
				</a>
			))}
		</div>
	</section>

	<!-- Blog Posts Section -->
	<section aria-label="Blog post list" id="posts">
		<div class="mb-8 flex items-center gap-3">
			<h2 class="title text-xl">最新文章</h2>
			<span class="h-px flex-1 bg-accent/10"></span>
			<a href="/posts/" class="text-sm text-accent/70 transition-colors hover:text-accent">
				查看全部 →
			</a>
		</div>
		<ul class="space-y-4">
			{
				allPostsByDate.map((p) => (
					<li class="grid gap-2 sm:grid-cols-[auto_1fr] sm:[&_q]:col-start-2">
							<PostPreview post={p} />
					</li>
				))
			}
		</ul>
	</section>
</PageLayout>
